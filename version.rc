#include <winver.h>

1 VERSIONINFO
	FILEVERSION 2, 4, 0, 0
	PRODUCTVERSION 2, 4, 0, 0
	FILEFLAGSMASK 0x17L
#ifdef _DEBUG
	FILEFLAGS VS_FF_DEBUG
#else
	FILEFLAGS 0
#endif
	FILEOS VOS_NT
	FILETYPE VFT_DLL
	FILESUBTYPE VFT2_UNKNOWN
BEGIN
