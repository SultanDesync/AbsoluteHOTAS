	BEGIN
		BLOCK "040904B0"
		BEGIN
			VALUE "FileDescription", ""
			VALUE "FileVersion", "2.4.0-beta"
			VALUE "InternalName", "StarfieldFlightControl"
			VALUE "LegalCopyright", "GNU General Public License v3.0"
			VALUE "ProductName", ""
			VALUE "ProductVersion", "2.4.0-beta"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
